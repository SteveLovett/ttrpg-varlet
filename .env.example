VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Liveblocks (Phase F5 — live session layer)
# Public key from https://liveblocks.io/dashboard → your project → API keys.
# Safe to expose in the browser; only authenticates room negotiations against
# the Liveblocks-auth Edge Function.
VITE_LIVEBLOCKS_PUBLIC_KEY=

# Secret key for the Supabase Edge Function only. Never put this in a VITE_
# variable. Set it on Supabase with:
#   supabase secrets set LIVEBLOCKS_SECRET_KEY=sk_...
# (Listed here for documentation only; not read from .env at build time.)
# LIVEBLOCKS_SECRET_KEY=
